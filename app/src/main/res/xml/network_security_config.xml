<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 允许连接本机或局域网里的 Ollama / 兼容服务（http://127.0.0.1:11434 等）。 -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
